#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// roBa-ish-m（robaish-m の config/roBa.keymap）と同じキーマップ・レイヤー
// LisM にしかないキーは空白（&none / &trans）

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <18 19>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                &kp T                                                         &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &lt 3 F              &kp G                                                         &kp H        &kp J  &kp K      &kp L    &mt RC(SQT) SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                &kp B                                                         &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT DELETE
&kp LS(RCTRL)     &kp LEFT_WIN  &kp LEFT_ALT  &mt LCTRL LA(GRAVE)  &kp SPACE  &mt LG(LC(LEFT_WIN)) LA(GRAVE)    &lt 2 BACKSPACE  &lt 1 ENTER  &none  &none      &none    &lt 5 SLASH
                                &none         &none                &none                                                         &none        &none  &none
            >;
        };

        FUNCTION {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                    &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp GRAVE         &trans            &trans            &trans            &trans                              &kp LEFT_ARROW    &kp DOWN_ARROW    &kp UP_ARROW      &kp RIGHT_ARROW   &kp NON_US_BACKSLASH
&trans            &trans            &trans            &trans            &trans                              &kp LC(X)         &kp LC(C)         &kp LC(V)         &kp LEFT_BRACKET  &mt RIGHT_SHIFT RIGHT_BRACKET
&trans            &trans            &trans            &trans            &trans            &trans    &trans  &trans            &trans            &trans            &trans            &kp SQT
                                    &trans            &trans            &trans                              &trans            &trans            &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp SLASH     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&trans  &trans  &trans  &trans  &trans                    &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&trans  &trans  &trans  &trans  &trans                    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans        &kp PRINTSCREEN
                &trans  &trans  &trans                    &trans        &trans        &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp LS(LG(S))       &kp LG(UP_ARROW)     &trans            &trans                    &trans          &trans          &trans        &trans           &trans
&kp TAB     &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &trans            &trans                    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans      &trans              &kp LG(DOWN_ARROW)   &kp LA(LEFT_ALT)  &trans                    &trans          &trans          &trans        &trans           &trans
&trans      &trans              &trans               &trans            &trans  &trans    &trans  &trans          &trans          &trans        &trans           &trans
                                &trans               &trans            &trans                    &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LC(RIGHT_ARROW)) LC(LG(LEFT_ARROW))>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans    &trans
                &trans  &trans  &trans                    &trans  &trans    &trans
            >;
        };

        SCROLL {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                &kp F6               &kp F7                  &kp F8         &kp F9                   &kp F10
&trans  &trans  &trans  &trans  &trans                                &kp HOME             &mkp MB1                &kp PAGE_UP    &mkp MB2                 &kp F11
&trans  &trans  &trans  &trans  &trans                                &kp END              &kp LG(LS(LEFT_ARROW))  &kp PAGE_DOWN  &kp LG(LS(RIGHT_ARROW))  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans                  &trans         &trans                   &trans
                &trans  &trans  &trans                                &trans               &trans                  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans                    &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                    &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans    &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
                      &trans        &trans        &trans                    &trans        &trans        &trans
            >;
        };
    };
};
